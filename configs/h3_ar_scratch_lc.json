{
    "method": "ar",
    "model_type": "scratch",
    "hidden_size": 128,
    "num_layers": 4,
    "num_attention_heads": 8,
    "data_path": "dataset/data/processed/processed_oas_multi.json",
    "target_region": "h3",
    "eval_split": "validation",
    "max_len": 384,
    "include_partner_chain": true,
    "output_dir": "./results",
    "num_train_epochs": 20,
    "per_device_train_batch_size": 32,
    "learning_rate": 0.0001,
    "do_train": true,
    "do_eval": true,
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "load_best_model_at_end": true,
    "metric_for_best_model": "core_accuracy",
    "greater_is_better": true,
    "early_stopping_patience": 3,
    "report_to": "tensorboard",
    "gen_num_examples": 150,
    "gen_num_samples": 20,
    "gen_top_p": 0.9,
    "gen_judge": "Exscientia/IgBert"
}
