{
  "model_type": "facebook/esm2_t12_35M_UR50D",
  "target_region": "h3",
  "data_path": "data/processed/processed_oas_multi.json",
  "eval_split": "validation",
  "max_len": 384,
  "output_dir": "./results",
  "do_train": true,
  "do_eval": true,
  "per_device_train_batch_size": 4,
  "learning_rate": 3e-05,
  "num_train_epochs": 20,
  "eval_strategy": "epoch",
  "save_strategy": "epoch",
  "metric_for_best_model": "core_accuracy",
  "greater_is_better": true,
  "load_best_model_at_end": true,
  "save_total_limit": 2,
  "report_to": "tensorboard",
  "gen_decoding": "independent",
  "early_stopping_patience": 3,
  "method": "mlm",
  "include_antigen": false,
  "anchor_trim": 2,
  "warmup_steps": 0,
  "warmup_ratio": 0.06,
  "weight_decay": 0.01,
  "masking_policy": "full_span",
  "loss_type": "cross_entropy",
  "train_length_predictor": true,
  "length_predictor_epochs": 20,
