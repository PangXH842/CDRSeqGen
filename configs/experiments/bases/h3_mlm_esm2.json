  "length_predictor_batch_size": 16,
  "run_generative_eval": true,
  "gen_length_mode": "inferred",
  "gen_min_length": null,
  "gen_max_length": null,
  "gen_length_temperature": 1.0,
  "gen_num_examples": 150,
  "gen_num_samples": 20,
  "gen_top_p": 0.9,
  "gen_top_k": 0,
  "gen_temperature": 1.0,
  "gen_seed": 42,
  "gen_stratify": false,
  "gen_judge": "Exscientia/IgBert",
  "gen_judge_partner_context": "with",
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 8,
  "include_partner_chain": false,
  "context_dropout": 0.0,
  "gen_eval_context_ablation": false
}
