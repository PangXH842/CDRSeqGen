{
    "method": "s2s",
    "model_type": "Rostlab/prot_bert",
    "hidden_size": 128,
    "num_layers": 4,
    "num_decoder_layers": 2,
    "num_attention_heads": 8,
    "data_path": "data/processed/processed_oas_multi.json",
    "target_region": "h3",
    "eval_split": "validation",
    "max_len": 384,
    "include_partner_chain": true,
    "output_dir": "./results",
    "num_train_epochs": 10,
    "per_device_train_batch_size": 4,
    "learning_rate": 3e-05,
    "do_train": true,
    "do_eval": true,
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "load_best_model_at_end": true,
    "metric_for_best_model": "core_accuracy",
    "greater_is_better": true,
    "early_stopping_patience": 3,
    "report_to": "tensorboard",
    "gen_num_examples": 150,
    "gen_num_samples": 20,
    "gen_top_p": 0.9,
    "gen_judge": "Exscientia/IgBert",
    "encoder_init": "pretrained",
    "freeze_encoder": false,
    "per_device_eval_batch_size": 4,
    "gradient_accumulation_steps": 8,
    "warmup_ratio": 0.06,
    "weight_decay": 0.01,
    "gen_seed": 42,
    "gen_temperature": 1.0,
    "gen_top_k": 0,
    "gen_stratify": false,
    "run_generative_eval": true
}
